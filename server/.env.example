# Copy to server/.env and adjust. Safe defaults are used when a value is absent.
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/masir

# Signing secret for HMAC bearer tokens. CHANGE THIS in any non-local environment.
JWT_SECRET=change-me
JWT_TTL_SECONDS=604800

# One-time passwords
OTP_TTL_SECONDS=300
OTP_DEV_PRINT=true
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=30

# Placeholders for a real SMS provider (see README; not used by the stub sender)
SMS_PROVIDER_MODULE=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example-user
SMTP_PASS=change-me
SMTP_FROM=no-reply@example.com

# Comma-separated Iranian phone numbers that become admins on first login
ADMIN_PHONES=+989120000000

# Browser origin(s) allowed by CORS. Use * for development only.
WEB_ORIGIN=http://localhost:8080

# Set to true only if your PostgreSQL provider requires TLS.
DB_SSL=false
PGPOOL_MAX=10
